{
  "mcpServers": {
    "eduhub-db": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "${MYSQL_PORT:-3306}",
        "MYSQL_USER": "${MYSQL_READONLY_USER:-eduhub_readonly}",
        "MYSQL_PASS": "${MYSQL_READONLY_PASSWORD:-}",
        "MYSQL_DB": "${MYSQL_DATABASE:-eduhub}",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false",
        "ALLOW_DDL_OPERATION": "false"
      }
    }
  }
}
