{
  "name": "@eduhub/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:api": "openapi-generator-cli generate -i openapi.json -g typescript-axios -o src/generated --additional-properties=supportsES6=true,withSeparateModelsAndApi=false",
    "refresh:spec": "node scripts/refresh-spec.mjs"
  },
  "dependencies": {
    "axios": "1.7.7"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.15.3"
  }
}
