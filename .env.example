# 이 파일을 복사해 .env를 만들고 실제 값을 채우세요.
# .env는 Git에 커밋하지 않습니다.

APP_ENV=development
APP_PORT=3000

# --- dev 프로필 + docker-compose MySQL (application-dev.yml, docker-compose.yml) ---
# dev 프로필은 이 .env 파일을 직접 읽는다: ./gradlew bootRun --args='--spring.profiles.active=dev'
# 개발용 MySQL은 root 계정으로 접속한다 (D-13)
MYSQL_DATABASE=eduhub
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# --- Claude Code MySQL MCP 서버 (.mcp.json, D-40) ---
# 개발 DB의 읽기 전용 계정(eduhub_readonly, SELECT·SHOW VIEW만)으로 접속한다. 비밀번호는 각자 정한다.
# 주의: .mcp.json은 이 .env 파일이 아니라 OS 환경 변수를 읽는다. 사용자 환경 변수로 설정한 뒤 Claude 앱을 다시 시작한다.
#   PowerShell: [Environment]::SetEnvironmentVariable('MYSQL_READONLY_PASSWORD', '<비밀번호>', 'User')
# 계정 만들기·비밀번호 맞추기: .\scripts\setup-db-readonly.ps1 (root 비밀번호를 묻는다, 다시 실행해도 안전)
MYSQL_READONLY_USER=eduhub_readonly
MYSQL_READONLY_PASSWORD=

# --- JWT 서명 키 (dev·prod 필수, 32바이트 이상). local은 기본값이 있다 ---
JWT_SECRET=

# --- prod 프로필에서 필요 (application-prod.yml) ---
# 프로필은 실행 환경에서 지정: SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/eduhub
DB_USERNAME=
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
