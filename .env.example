# 이 파일을 복사해 .env를 만들고 실제 값을 채우세요.
# .env는 Git에 커밋하지 않습니다.

APP_ENV=development
APP_PORT=3000

# --- dev 프로필 + docker-compose MySQL (application-dev.yml, docker-compose.yml) ---
# dev 프로필은 이 .env 파일을 직접 읽는다: ./gradlew bootRun --args='--spring.profiles.active=dev'
MYSQL_DATABASE=eduhub
MYSQL_USER=eduhub
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# --- prod 프로필에서 필요 (application-prod.yml) ---
# 프로필은 실행 환경에서 지정: SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/eduhub
DB_USERNAME=
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
